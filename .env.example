# TurboxClipsPro Web - Configuración
# Copia este archivo a .env y completa los valores

SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Local: sqlite:///./turbox_web.db
# Producción (Neon): postgresql://usuario:password@host/regional/db?sslmode=require
DATABASE_URL=sqlite:///./turbox_web.db

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TurboxClipsPro <tu-email@gmail.com>

APP_NAME=TurboxClipsPro
APP_URL=http://localhost:8000

# URL pública del .exe (GitHub Releases en producción)
DOWNLOAD_URL=/downloads/TurboxClipsPro.exe

ADMIN_WHATSAPP=18293670355

# Panel de administración
ADMIN_PASSWORD=
# Clave de acceso directo: /admin?key=... (40 caracteres aleatorios)
ADMIN_ACCESS_KEY=

# Dominio del frontend en Netlify (para CORS). Sin barra final.
FRONTEND_URL=
